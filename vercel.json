{
  "version": 2,
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "frontend",
  "routes": [
    {
      "src": "/",
      "dest": "/landing.html"
    },
    {
      "src": "/index.html",
      "dest": "/landing.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
